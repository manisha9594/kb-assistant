LLM_PROVIDER=openai          # or "fake" to run offline without any API key
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: enables the web search route (free tier at https://tavily.com)
TAVILY_API_KEY=

# Retrieval tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MIN_RELEVANCE=0.25
